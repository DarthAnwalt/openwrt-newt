#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT

USE_PROCD=1
START=99
STOP=1

# This is an on-demand worker. Package installation may enable init scripts,
# but an APK transaction must never run merely because the router booted.
boot() {
	return 0
}

start_service() {
	procd_open_instance
	procd_set_param command /usr/libexec/luci-app-zt-update
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
