#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT

USE_PROCD=1
START=99
STOP=1
ACTION_FILE='/var/run/pangolin-newt-update.action'

# Package post-install may enable scripts under /etc/init.d. Never run an APK
# transaction merely because the router booted; only an explicit LuCI action
# calls start_service().
boot() {
	return 0
}

start_service() {
	[ -s "$ACTION_FILE" ] || return 0

	procd_open_instance
	procd_set_param command /usr/libexec/pangolin-newt-update
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
