#!/bin/sh
# SPDX-License-Identifier: MIT

set -eu
umask 077

source_file=/root/.config/newt-client/config.json
mode=${1:-}
force=${2:-}

usage() {
	cat <<'EOF'
Usage: newt-migrate --check
       newt-migrate --apply [--force]

--check shows which fields can be migrated without printing credentials.
--apply writes endpoint, id, secret and log_level to /etc/config/newt.
--force permits replacing an already configured UCI section.
The source JSON file is never removed or modified.
EOF
}

case "$mode" in
	--check|--apply) ;;
	*) usage; exit 2 ;;
esac

[ -r "$source_file" ] || {
	echo "No readable legacy configuration at $source_file" >&2
	exit 1
}

endpoint=$(jsonfilter -i "$source_file" -e '@.endpoint')
id=$(jsonfilter -i "$source_file" -e '@.id')
secret=$(jsonfilter -i "$source_file" -e '@.secret')
log_level=$(jsonfilter -i "$source_file" -e '@.logLevel')

[ -n "$endpoint" ] && [ -n "$id" ] && [ -n "$secret" ] || {
	echo 'Legacy JSON does not contain endpoint, id and secret.' >&2
	exit 1
}

if [ "$mode" = '--check' ]; then
	echo 'Migration is available: endpoint, id, secret and optional log level were found.'
	exit 0
fi

current_endpoint=$(uci -q get newt.main.endpoint || true)
current_id=$(uci -q get newt.main.id || true)
current_secret=$(uci -q get newt.main.secret || true)

if [ -n "$current_endpoint$current_id$current_secret" ] && [ "$force" != '--force' ]; then
	echo 'UCI is already configured; use --apply --force to replace it.' >&2
	exit 1
fi

uci set newt.main=newt
uci set newt.main.endpoint="$endpoint"
uci set newt.main.id="$id"
uci set newt.main.secret="$secret"
uci set newt.main.log_level="${log_level:-INFO}"
uci set newt.main.enabled='1'
uci commit newt
chmod 0600 /etc/config/newt

/etc/init.d/newt enable
/etc/init.d/newt restart
echo 'Migration complete. The legacy JSON was left untouched.'

