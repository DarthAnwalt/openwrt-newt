Subject: [PATCH] golang: backport Go 1.26.10 security point release
License: GPL-2.0-only

--- a/lang/golang/golang1.26/Makefile
+++ b/lang/golang/golang1.26/Makefile
@@ -9,8 +9,8 @@
 PKG_NAME:=golang1.26
 GO_VERSION_MAJOR_MINOR:=1.26
-GO_VERSION_PATCH:=9
+GO_VERSION_PATCH:=10
 GO_VERSION_RC:=
 GO_BOOTSTRAP_VERSION:=bootstrap
-PKG_HASH:=9735d7dcdb65b35d3fa577f04064737c03b89cf1a2b71e6e69fe2f3c6f9fd4ca
+PKG_HASH:=fd63e883ba2f2bfca93c1646b31ebef63e2b1e4d2b317c9789d976a68d81f36f

 PKG_VERSION:=$(GO_VERSION_MAJOR_MINOR)$(if $(GO_VERSION_RC),.0)$(if $(GO_VERSION_PATCH),.$(GO_VERSION_PATCH))
